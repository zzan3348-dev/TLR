{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/diplomacy/:route",
      "destination": "/api/diplomacy-dispatch?route=:route"
    },
    {
      "source": "/api/economy/:route",
      "destination": "/api/economy-dispatch?route=:route"
    },
    {
      "source": "/api/trade/:route",
      "destination": "/api/trade-dispatch?route=:route"
    },
    {
      "source": "/api/military/:route",
      "destination": "/api/military-dispatch?route=:route"
    },
    {
      "source": "/api/intelligence/:route",
      "destination": "/api/intelligence-dispatch?route=:route"
    },
    {
      "source": "/api/research/:route",
      "destination": "/api/economy-dispatch?domain=research&route=:route"
    },
    {
      "source": "/api/decisions/:route",
      "destination": "/api/economy-dispatch?domain=decisions&route=:route"
    },
    {
      "source": "/api/events/:route",
      "destination": "/api/economy-dispatch?domain=events&route=:route"
    },
    {
      "source": "/api/admin/research",
      "destination": "/api/admin/actions?domain=research"
    },
    {
      "source": "/api/map-capitals",
      "destination": "/api/economy-dispatch?domain=map&route=capitals"
    },
    {
      "source": "/api/admin/map-capitals",
      "destination": "/api/admin/actions?domain=map-capitals"
    },
    {
      "source": "/api/admin/province-regions",
      "destination": "/api/admin/actions?domain=province-regions"
    },
    {
      "source": "/api/admin/intelligence",
      "destination": "/api/admin/actions?domain=intelligence"
    },
    {
      "source": "/api/navi/:route",
      "destination": "/api/economy-dispatch?domain=navi&route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
