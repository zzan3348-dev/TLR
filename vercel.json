{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/diplomacy/:route",
      "destination": "/api/diplomacy-dispatch?route=:route"
    },
    {
      "source": "/api/economy/:route",
      "destination": "/api/economy-dispatch?route=:route"
    },
    {
      "source": "/api/trade/:route",
      "destination": "/api/trade-dispatch?route=:route"
    },
    {
      "source": "/api/military/:route",
      "destination": "/api/military-dispatch?route=:route"
    },
    {
      "source": "/api/intelligence/:route",
      "destination": "/api/diplomacy-dispatch?domain=intelligence&route=:route"
    },
    {
      "source": "/api/world-control/:route",
      "destination": "/api/diplomacy-dispatch?domain=world-control&route=:route"
    },
    {
      "source": "/api/research/:route",
      "destination": "/api/economy-dispatch?domain=research&route=:route"
    },
    {
      "source": "/api/decisions/:route",
      "destination": "/api/economy-dispatch?domain=decisions&route=:route"
    },
    {
      "source": "/api/events/:route",
      "destination": "/api/economy-dispatch?domain=events&route=:route"
    },
    {
      "source": "/api/admin/research",
      "destination": "/api/admin/actions?adminRoute=research"
    },
    {
      "source": "/api/map-capitals",
      "destination": "/api/economy-dispatch?domain=map&route=capitals"
    },
    {
      "source": "/api/admin/map-capitals",
      "destination": "/api/admin/actions?adminRoute=map-capitals"
    },
    {
      "source": "/api/admin/province-regions",
      "destination": "/api/admin/actions?adminRoute=province-regions"
    },
    {
      "source": "/api/admin/intelligence",
      "destination": "/api/admin/actions?adminRoute=intelligence"
    },
    {
      "source": "/api/admin/world-control",
      "destination": "/api/admin/actions?adminRoute=world-control"
    },
    {
      "source": "/api/admin/site-status",
      "destination": "/api/admin/actions?adminRoute=site-status"
    },
    {
      "source": "/api/admin/country-applications",
      "destination": "/api/admin/actions?adminRoute=country-applications"
    },
    {
      "source": "/api/admin/preview",
      "destination": "/api/admin/actions?adminRoute=preview"
    },
    {
      "source": "/api/admin/discord-login",
      "destination": "/api/admin/actions?adminRoute=discord-login"
    },
    {
      "source": "/api/admin/content-studio",
      "destination": "/api/admin/actions?adminRoute=content-studio"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/session?domain=logout"
    },
    {
      "source": "/api/navi/:route",
      "destination": "/api/economy-dispatch?domain=navi&route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
