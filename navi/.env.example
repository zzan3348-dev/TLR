# 새 Discord Application에서 발급한 값만 사용합니다.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# 테스트 서버에서 즉시 명령을 동기화할 때만 지정합니다.
DISCORD_GUILD_ID=

# 배포된 TLR 사이트와 서버에 동일한 전용 토큰을 설정합니다.
TLR_API_BASE_URL=https://example.com
TLR_NAVI_SERVICE_TOKEN=

# NAVI 고유 상태만 저장하는 새 DB입니다. 옛 DB 경로를 지정하지 마세요.
NAVI_DATABASE_PATH=data/new_navi.sqlite3
NAVI_OWNER_USER_ID=
NAVI_NOTIFICATION_CHANNEL_ID=
NAVI_COIN_EMOJI=🪙
BOOST_BADGE_GUILD_ID=
BOOST_BADGE_KEY=staff_sponsor

# 봇 직접 멘션 기반 Gemini 대화입니다. 실제 키는 Railway Variables에만 저장합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
NAVI_LLM_TIMEOUT_SECONDS=20
